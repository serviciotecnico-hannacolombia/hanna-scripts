// ==UserScript==
// @name         Cola de Llamadas Sync - Hanna Colombia
// @namespace    https://intranet.hannacolombia.com/
// @version      0.3.0
// @description  Conecta la intranet con la app de Servicio Técnico (módulo Llamadas). En el Libro de Trabajo: envía la lista "Esperando Llamada Seguimiento Diagnóstico" (y la relee cada 10 min con cualquier pestaña de la intranet abierta). En el formulario "Llamada de Seguimiento Diagnóstico": fecha sugerida con la carga real del equipo, calendario con festivos, mensajes rápidos compartidos, avisos de prioritaria y de quién está llamando, llamada agrupada por cliente y registro de la llamada en la bitácora al dar Continuar. Nunca presiona Continuar por ti (salvo el cierre automático del grupo, si lo activas en la app).
// @author       Servicio Técnico Hanna Colombia
// @match        https://intranet.hannacolombia.com/*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @connect      mmawukdxoryswwnjhydl.supabase.co
// @run-at       document-idle
// ==/UserScript==

// Diseño: docs/llamadas-tiempo-real.md (fases 1 y 3).
// Configuración: menú de Tampermonkey → "Configurar token de llamadas". El token
// se genera en la app (módulo Llamadas) y es personal: identifica quién envió la
// lectura o registró la llamada. Se guarda en Tampermonkey, no en la intranet.
// Reemplaza a los userscripts "Planificador de Llamadas" y "Llamada de
// Seguimiento Diagnóstico": desactívalos para que no dupliquen el calendario.

(function () {
  'use strict';

  const VERSION = '0.3.0';
  const ENDPOINT = 'https://mmawukdxoryswwnjhydl.supabase.co/functions/v1/llamadas-sync';
  const URL_LIBRO = '/stecnico/libro_trabajo';
  const ES_LIBRO = location.pathname.startsWith(URL_LIBRO);
  const ES_LLAMADA = /^\/stecnico\/item\/\d+\/diagnosiscall/.test(location.pathname);
  const CADA_MS = 10 * 60 * 1000;     // relectura en segundo plano
  const REVISAR_MS = 60 * 1000;       // cada cuánto una pestaña mira si ya toca
  const BLOQUEO_MS = 2 * 60 * 1000;   // una sola pestaña lee a la vez

  const G = {
    token: 'hll_token', ultima: 'hll_ultima_lectura', bloqueo: 'hll_bloqueo', estado: 'hll_estado',
    pendientes: 'hll_pendientes',     // llamadas registradas aún no confirmadas por la app
    grupo: 'hll_grupo_aviso',         // llamada agrupada en curso: OTST que faltan por registrar
  };

  // ─────────────────────────────────────────────
  // Utilidades
  // ─────────────────────────────────────────────
  const norm = (t) => (t || '').replace(/\s+/g, ' ').trim().toLowerCase();
  const limpio = (t) => (t || '').replace(/\s+/g, ' ').trim();
  const pad = (n) => String(n).padStart(2, '0');
  const clave = (f) => `${f.getFullYear()}-${pad(f.getMonth() + 1)}-${pad(f.getDate())}`;
  const deClave = (k) => { const [y, m, d] = String(k).split('-').map(Number); return new Date(y, m - 1, d); };
  const d0 = (f) => new Date(f.getFullYear(), f.getMonth(), f.getDate());
  const mismoDia = (a, b) => a && b && clave(a) === clave(b);

  function parsear(txt) {
    const m = (txt || '').match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (!m) return null;
    const d = new Date(+m[3], +m[2] - 1, +m[1]);
    return d.getMonth() === +m[2] - 1 ? d : null;
  }
  // El sitio usa DD/MM/AAAA
  const formatear = (f) => `${pad(f.getDate())}/${pad(f.getMonth() + 1)}/${f.getFullYear()}`;

  // "19sem 5d 16h 59m" / "1d 23h 42m" / "21h 39m" -> días enteros
  function diasDe(txt) {
    const n = (re) => +((txt.match(re) || [])[1] || 0);
    return Math.floor(n(/(\d+)\s*sem/) * 7 + n(/(\d+)\s*d\b/) + n(/(\d+)\s*h\b/) / 24);
  }

  const uuid = () => (crypto.randomUUID ? crypto.randomUUID()
    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
      const r = (Math.random() * 16) | 0; return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
    }));

  // ── Festivos de Colombia (igual que src/lib/colombiaCalendar.ts de la app) ──
  function pascua(y) {
    const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4;
    const f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;
    const i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
    const x = h + l - 7 * m + 114;
    return new Date(y, Math.floor(x / 31) - 1, (x % 31) + 1);
  }
  const cacheFestivos = {};
  function festivos(y) {
    if (cacheFestivos[y]) return cacheFestivos[y];
    const s = new Set();
    const add = (f) => s.add(clave(f));
    const alLunes = (f) => { const r = d0(f); while (r.getDay() !== 1) r.setDate(r.getDate() + 1); return r; };
    [[0, 1], [4, 1], [6, 20], [7, 7], [11, 8], [11, 25]].forEach(([m, d]) => add(new Date(y, m, d)));
    const trasladables = [[0, 6], [2, 19], [5, 29], [7, 15], [9, 12], [10, 1], [10, 11]];
    if (y >= 2026) trasladables.push([6, 9]); // Ley 2578 de 2026
    trasladables.forEach(([m, d]) => add(alLunes(new Date(y, m, d))));
    const p = pascua(y);
    [-3, -2].forEach((n) => { const r = new Date(p); r.setDate(r.getDate() + n); add(r); });
    [39, 59, 70].forEach((n) => { const r = new Date(p); r.setDate(r.getDate() + n); add(alLunes(r)); });
    return (cacheFestivos[y] = s);
  }
  const esFinDeSemana = (f) => f.getDay() === 0 || f.getDay() === 6;
  const esFestivo = (f) => festivos(f.getFullYear()).has(clave(f));
  const esHabil = (f) => !esFinDeSemana(f) && !esFestivo(f);
  function sigHabil(f) { const r = d0(f); do { r.setDate(r.getDate() + 1); } while (!esHabil(r)); return r; }
  function sumarHabiles(f, n) { let r = d0(f); for (let i = 0; i < n; i++) r = sigHabil(r); return r; }
  function ajustarHabil(f) { const r = d0(f); while (!esHabil(r)) r.setDate(r.getDate() + 1); return r; }

  // ─────────────────────────────────────────────
  // Lectura de la tabla del Libro (se ubica por el texto de los encabezados)
  // ─────────────────────────────────────────────
  function tablaLlamadas(raiz) {
    return [...raiz.querySelectorAll('table')].find((t) =>
      t.rows.length > 1 && !t.classList.contains('sticky-header') && /fecha próximo contacto/i.test(t.rows[0].textContent)) || null;
  }

  function leerFilas(t) {
    const cab = [...t.rows[0].cells].map((c) => norm(c.textContent));
    const col = (re) => cab.findIndex((h) => re.test(h));
    const iO = col(/^otst/), iE = col(/estado/), iT = col(/^tiempo/), iF = col(/próximo contacto/),
      iC = col(/^cliente/), iTec = col(/técnico/), iG = col(/garant/);
    if (iO < 0) throw new Error('la tabla no tiene columna OTST (¿cambió la intranet?)');
    return [...t.rows].slice(1).map((r) => {
      const c = r.cells;
      const tx = (i) => (i >= 0 && c[i] ? limpio(c[i].textContent) : '');
      const otst = (tx(iO).match(/\d+/) || [])[0];
      if (!otst) return null;
      const f = parsear(tx(iF));
      const sem = iE >= 0 && c[iE] ? c[iE].querySelector('[class*="semaforo_"]') : null;
      return {
        otst,
        cliente: tx(iC),
        tecnico: tx(iTec),
        garantia: iG >= 0 && !/^no$/i.test(tx(iG)),
        proximo_contacto: f ? clave(f) : null,
        dias: iT >= 0 ? diasDe(tx(iT)) : null,
        semaforo: sem ? (sem.className.match(/semaforo_(\w+)/) || [])[1] || '' : '',
      };
    }).filter(Boolean);
  }

  // Filtro "Modo" del Libro de Trabajo: se guarda en la sesión de la intranet (la URL
  // no cambia) y aplica también a la lectura en segundo plano. El desplegable NO es
  // confiable: Drupal lo pinta en "Sólo items de hoy" aunque la lista muestre todos.
  // Por eso el modo se deduce de los datos:
  //   - "Sólo items de hoy" solo trae OTST con fecha de hoy o sin fecha.
  //   - "Todos los items" trae también vencidas y futuras.
  // Completa = hay alguna fecha distinta de hoy Y el número del encabezado
  // "Esperando Llamada Seguimiento Diagnóstico (N)" (si se encuentra) coincide con
  // las filas leídas. Ante la duda es parcial, que nunca marca salidas.
  function totalDeclarado(doc) {
    const m = (doc.body ? doc.body.textContent : '').match(/Esperando Llamada Seguimiento Diagn\S*\s*\((\d+)\)/i);
    return m ? +m[1] : null;
  }

  function deducirModo(doc, filas) {
    const hoy = clave(new Date());
    const fueraDeHoy = filas.filter((f) => f.proximo_contacto && f.proximo_contacto !== hoy).length;
    const declarado = totalDeclarado(doc);
    const cuadra = declarado === null || declarado === filas.length;
    const completa = fueraDeHoy > 0 && cuadra;
    const modo = completa ? 'Todos los items (detectado)'
      : !cuadra ? `Parcial: ${filas.length} de ${declarado} filas`
      : 'Sólo items de hoy (detectado)';
    return { modo, completa };
  }

  // { filas, vacia, modo, completa } o lanza error si la página no es la esperada
  function leerDocumento(doc) {
    const t = tablaLlamadas(doc);
    if (t) {
      const filas = leerFilas(t);
      return { filas, vacia: false, ...deducirModo(doc, filas) };
    }
    if (/Esperando Llamada Seguimiento Diagn/i.test(doc.body ? doc.body.textContent : '')) {
      return { filas: [], vacia: true, modo: 'Lista vacía', completa: false };
    }
    throw new Error('no se encontró la lista (¿se cerró la sesión de la intranet?)');
  }

  // ─────────────────────────────────────────────
  // Envío a llamadas-sync
  // ─────────────────────────────────────────────
  function enviar(cuerpo) {
    const token = GM_getValue(G.token, '');
    if (!token) return Promise.reject(new Error('falta configurar el token (menú de Tampermonkey)'));
    return new Promise((resolve, reject) => {
      GM_xmlhttpRequest({
        method: 'POST',
        url: ENDPOINT,
        headers: { 'Content-Type': 'application/json', 'x-llamadas-token': token },
        data: JSON.stringify(cuerpo),
        timeout: 30000,
        onload: (r) => {
          let d = null;
          try { d = JSON.parse(r.responseText); } catch (e) { /* respuesta no JSON */ }
          if (r.status >= 200 && r.status < 300 && d && d.ok) { resolve(d); return; }
          const err = new Error((d && d.error) || `HTTP ${r.status}`);
          err.rechazada = !!(d && d.rechazada);
          err.definitivo = !!(d && d.definitivo) || r.status === 401;
          reject(err);
        },
        onerror: () => reject(new Error('sin conexión con la app')),
        ontimeout: () => reject(new Error('la app no respondió a tiempo')),
      });
    });
  }

  function guardarEstado(e) {
    GM_setValue(G.estado, { ...e, ts: Date.now() });
    pintar();
  }

  async function sincronizar(doc, forzar = false) {
    const { filas, vacia, modo, completa } = leerDocumento(doc);
    if (forzar && !completa) throw new Error(`para forzar, la lista debe estar completa (${modo})`);
    let r;
    try {
      r = await enviar({ accion: 'cola', completa, modo, vacia, filas, forzar, version: VERSION });
    } catch (e) {
      if (e.rechazada) {
        guardarEstado({ ok: false, texto: `Lectura rechazada: ${e.message}. Si es correcto, usa «Forzar envío» en el menú de Tampermonkey.` });
        return null;
      }
      throw e;
    }
    GM_setValue(G.ultima, Date.now());
    guardarEstado({
      ok: true,
      texto: completa
        ? `${r.total} OTST enviadas (+${r.entraron} / −${r.salieron})`
        : `${r.total} OTST enviadas como parcial (${modo}). Para la cola completa pon Modo en «Todos los items» y dale Filtrar`,
    });
    return r;
  }

  // Lectura en segundo plano: una sola pestaña a la vez, y solo si ya pasó el intervalo
  async function quizasReleer() {
    if (!GM_getValue(G.token, '')) return;
    const ahora = Date.now();
    if (ahora - GM_getValue(G.ultima, 0) < CADA_MS) return;
    if (ahora - GM_getValue(G.bloqueo, 0) < BLOQUEO_MS) return;
    GM_setValue(G.bloqueo, ahora);
    GM_setValue(G.ultima, ahora); // si falla (sesión cerrada…), no se reintenta hasta el próximo intervalo
    try {
      const r = await fetch(URL_LIBRO, { credentials: 'same-origin' });
      const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
      await sincronizar(doc);
    } catch (e) {
      guardarEstado({ ok: false, texto: e.message });
    } finally {
      GM_setValue(G.bloqueo, 0);
    }
  }

  // ─────────────────────────────────────────────
  // Indicador en el Libro de Trabajo
  // ─────────────────────────────────────────────
  function pintar() {
    if (!ES_LIBRO) return;
    let el = document.getElementById('hll-estado');
    if (!el) {
      el = document.createElement('div');
      el.id = 'hll-estado';
      el.style.cssText = 'position:fixed;right:14px;bottom:14px;z-index:2147483000;padding:7px 12px;border-radius:16px;'
        + 'font:12px Arial,sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.2);cursor:pointer;max-width:360px';
      el.title = 'Cola de llamadas → app de Servicio Técnico. Clic para enviar de nuevo.';
      el.addEventListener('click', () => enviarEstaPagina());
      document.body.appendChild(el);
    }
    const e = GM_getValue(G.estado, null);
    const token = GM_getValue(G.token, '');
    const ok = token && e && e.ok;
    el.style.background = !token ? '#fff1c2' : ok ? '#e3f4e8' : e ? '#f8d0cc' : '#eef3f9';
    el.style.color = !token ? '#8a6100' : ok ? '#1e6b3a' : e ? '#8c1d12' : '#0b3d78';
    const hace = e ? Math.max(0, Math.round((Date.now() - e.ts) / 60000)) : 0;
    el.textContent = !token ? '☎ Llamadas: falta el token (menú de Tampermonkey)'
      : !e ? '☎ Llamadas: enviando…'
      : `☎ ${e.ok ? '✓' : '⚠'} ${e.texto}${hace ? ` · hace ${hace} min` : ''}`;
  }

  async function enviarEstaPagina(forzar = false) {
    guardarEstado({ ok: true, texto: 'enviando…' });
    try {
      await sincronizar(document, forzar);
    } catch (e) {
      guardarEstado({ ok: false, texto: e.message });
    }
  }

  // ═════════════════════════════════════════════
  // Registro de llamadas (bitácora)
  // Al dar Continuar la llamada se guarda en Tampermonkey y se envía cuando carga
  // la página siguiente: si esa página es otra vez el formulario con un error de
  // la intranet, se descarta (la llamada no se guardó allá). Lo que no se pueda
  // enviar se reintenta cada minuto en cualquier pestaña de la intranet.
  // ═════════════════════════════════════════════
  const leerPendientes = () => { const p = GM_getValue(G.pendientes, []); return Array.isArray(p) ? p : []; };

  function encolarLlamada(l) {
    const p = leerPendientes().filter((x) => x.id !== l.id);
    p.push({ ...l, encolada: Date.now() });
    GM_setValue(G.pendientes, p.slice(-200));
  }

  function hayErrorDeFormulario() {
    return [...document.querySelectorAll('.messages.error, .messages--error, .alert-danger, .error-message')]
      .some((e) => limpio(e.textContent).length > 0);
  }

  let enviandoPendientes = false;
  async function enviarPendientes() {
    if (enviandoPendientes || !GM_getValue(G.token, '')) return;
    enviandoPendientes = true;
    try {
      for (const l of leerPendientes()) {
        if (Date.now() - l.encolada < 3000) continue;
        try {
          const { encolada, ...llamada } = l; // eslint-disable-line no-unused-vars
          await enviar({ accion: 'llamada', llamada });
          GM_setValue(G.pendientes, leerPendientes().filter((x) => x.id !== l.id));
        } catch (e) {
          // Rechazo definitivo (datos inválidos, token revocado): no se reintenta para siempre
          if (e.definitivo || Date.now() - l.encolada > 7 * 864e5) {
            GM_setValue(G.pendientes, leerPendientes().filter((x) => x.id !== l.id));
          }
          if (!e.definitivo) break; // sin conexión: se intenta más tarde
        }
      }
    } finally {
      enviandoPendientes = false;
    }
  }

  // Al volver al mismo formulario con un error de la intranet, la llamada no se guardó:
  // se descarta lo encolado para esta OTST en los últimos 2 minutos.
  function descartarSiFallo() {
    if (!ES_LLAMADA || !hayErrorDeFormulario()) return;
    const otst = otstActual();
    GM_setValue(G.pendientes, leerPendientes().filter((x) => !(x.otst === otst && Date.now() - x.encolada < 2 * 60000)));
  }

  // Aviso flotante de la llamada agrupada en curso (en cualquier página de la intranet)
  function pintarAvisoGrupo() {
    const g = GM_getValue(G.grupo, null);
    const viejo = !g || Date.now() - g.ts > 12 * 3600e3;
    const faltan = viejo ? [] : (g.faltan || []).filter((o) => o !== (ES_LLAMADA ? otstActual() : ''));
    let el = document.getElementById('hll-grupo');
    if (!faltan.length) { if (el) el.remove(); if (viejo && g) GM_setValue(G.grupo, null); return; }
    if (!el) {
      el = document.createElement('div');
      el.id = 'hll-grupo';
      el.style.cssText = 'position:fixed;left:14px;bottom:14px;z-index:2147483000;padding:9px 12px;border-radius:10px;'
        + 'font:12.5px Arial,sans-serif;background:#f8f4ff;color:#4a2a85;border:1px solid #c9b8ea;border-left:4px solid #6b3fb5;'
        + 'box-shadow:0 2px 10px rgba(0,0,0,.15);max-width:420px';
      document.body.appendChild(el);
    }
    el.innerHTML = '';
    const b = document.createElement('b'); b.textContent = `🔗 Llamada agrupada${g.cliente ? ' — ' + g.cliente : ''}: `;
    el.append(b, `faltan ${faltan.length} por registrar: `);
    faltan.forEach((o, i) => {
      const a = document.createElement('a'); a.href = `/stecnico/item/${o}/diagnosiscall`; a.textContent = o; a.style.fontWeight = '700';
      el.append(i ? ', ' : '', a);
    });
    const x = document.createElement('a'); x.href = '#'; x.textContent = ' ✕'; x.title = 'Ocultar (no vuelve a aparecer para este grupo)';
    x.style.cssText = 'color:#8a97a6;text-decoration:none;margin-left:6px';
    x.addEventListener('click', (e) => { e.preventDefault(); GM_setValue(G.grupo, null); el.remove(); });
    el.append(x);
  }

  // ═════════════════════════════════════════════
  // Formulario "Llamada de Seguimiento Diagnóstico" (/stecnico/item/N/diagnosiscall)
  // ═════════════════════════════════════════════
  const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
  const DIAS = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do'];
  const ESTADO_LLAMADA = /llamada seguimiento diagn/i;
  const RE_ENCABEZADO = /Orden relacionada con las? OTST\s*([\d\s,y.]+?)\s*\.?\s*Se deja (?:el )?seguimiento en (?:la )?(?:OTST\s*)?(\d+)\.?/i;
  const otstActual = () => (location.pathname.match(/item\/(\d+)/) || [])[1] || '';
  const ordenar = (l) => [...new Set(l.map(String))].sort((a, b) => +a - +b);
  const textoEncabezado = (otsts, seg) => `Orden relacionada con la OTST ${otsts.join(', ')}. Se deja seguimiento en ${seg}`;

  function leerEncabezado(texto) {
    const m = (texto || '').match(RE_ENCABEZADO);
    if (!m) return null;
    return { otsts: ordenar((m[1].match(/\d{3,}/g) || []).concat(m[2])), seguimiento: m[2] };
  }

  function disparar(el) {
    el.dispatchEvent(new Event('input', { bubbles: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
  }

  function selectAccion() {
    for (const s of document.querySelectorAll('select')) {
      if ([...s.options].some((o) => /contactar nuevamente/i.test(o.text))) return s;
    }
    return null;
  }
  const opcion = (select, re) => [...select.options].find((o) => re.test(o.text)) || null;
  const esEfectivo = (select) => /contacto con el cliente fue efectivo/i.test(select.options[select.selectedIndex]?.text || '');

  // Primer <input> de texto que aparece DESPUÉS de una etiqueta con ese texto
  function inputTrasEtiqueta(texto) {
    const t = norm(texto);
    const etiquetas = [...document.querySelectorAll('label, b, strong, span, div, td, th')].filter(
      (el) => el.children.length <= 2 && norm(el.textContent).replace(/[:*\s]+$/, '').startsWith(t) && norm(el.textContent).length < t.length + 8
    );
    for (const et of etiquetas) {
      for (const inp of document.querySelectorAll('input:not([type=hidden]):not([type=submit]):not([type=button]):not([type=checkbox]):not([type=radio])')) {
        if (et.compareDocumentPosition(inp) & Node.DOCUMENT_POSITION_FOLLOWING) return inp;
      }
    }
    return null;
  }

  function botonContinuar() {
    for (const b of document.querySelectorAll('button, input[type=submit], input[type=button], a.button')) {
      if (/^continuar$/i.test((b.value || b.textContent || '').trim())) return b;
    }
    return null;
  }

  const areaObservacion = (select) => (select.form || document).querySelector('textarea');

  function elegirAccion(select, efectivo) {
    const op = opcion(select, efectivo ? /contacto con el cliente fue efectivo/i : /contactar nuevamente/i);
    if (!op || select.value === op.value) return;
    select.value = op.value;
